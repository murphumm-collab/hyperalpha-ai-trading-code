# Hyper Alpha Arena - Environment Configuration Template
# Copy this file to .env and fill in your values

# =================================================================
# Hyperliquid Trading Configuration (REQUIRED for real trading)
# =================================================================

# Encryption key for private key storage
# HYPERLIQUID_ENCRYPTION_KEY is automatically generated and persisted by Docker

# Hyperliquid defaults (optional, can be configured per account in UI)
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MIN_ORDER_VALUE=10.0
HYPERLIQUID_MAX_POSITION_VALUE_PER_ORDER=1000.0

# =================================================================
# Database Configuration (Auto-configured in Docker)
# =================================================================
# These are automatically set by docker-compose.yml
# DATABASE_URL=postgresql://alpha_user:alpha_pass@postgres:5432/alpha_arena
# SNAPSHOT_DATABASE_URL=postgresql://alpha_user:alpha_pass@postgres:5432/alpha_snapshots

# =================================================================
# Production Auth Boundary (REQUIRED for To C production)
# =================================================================

# Production should verify Bearer JWT signatures against the Casdoor/JWKS issuer.
# Local/demo mode can leave these unset, but production readiness will block.
AUTH_REQUIRE_VERIFIED_BEARER=false
# AUTH_JWKS_URL=https://auth.hyperalpha.org/.well-known/jwks.json
# AUTH_JWT_ISSUER=https://auth.hyperalpha.org
# AUTH_JWT_AUDIENCE=hyperalpha-app
AUTH_JWT_ALGORITHMS=RS256
# Do not leave the legacy default user as an env admin in production.
AUTH_ADMIN_USERNAMES=

# =================================================================
# Optional: Custom AI Model Configuration
# =================================================================
# If you want to set default API keys (can also be configured per account in UI)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Platform-owned LLM for background News AI classification.
# Leave unset to skip News AI classification; never uses user-provided Hyper AI keys.
# NEWS_AI_LLM_BASE_URL=https://api.deepseek.com
# NEWS_AI_LLM_MODEL=deepseek-chat
# NEWS_AI_LLM_API_KEY=your-platform-news-ai-key
# NEWS_AI_LLM_API_FORMAT=openai

# =================================================================
# Optional: AI Stream Runtime Capacity
# =================================================================

# Shared DeepSeek/Qwen/OpenAI task concurrency for AI assistants.
# Use Redis admission when running more than one backend instance.
AI_TASK_MAX_WORKERS=12
AI_BACKGROUND_MAX_WORKERS=4
# Optional stable instance name for admin runtime and task heartbeat records.
# Leave empty to auto-generate hostname:pid.
AI_STREAM_RUNNER_ID=
AI_STREAM_MAX_RUNNING_GLOBAL=12
AI_STREAM_MAX_RUNNING_PER_USER=2
AI_STREAM_PERSISTENCE_ENABLED=true
AI_STREAM_DB_RETENTION_SECONDS=86400

# Optional Redis-backed distributed admission leases.
# Leave AI_STREAM_REDIS_URL empty for single-server local admission.
# AI_STREAM_REDIS_URL=redis://redis:6379/0
AI_STREAM_DISTRIBUTED_ADMISSION_ENABLED=false
AI_STREAM_DISTRIBUTED_ADMISSION_PREFIX=hyperalpha:ai-stream
AI_STREAM_DISTRIBUTED_LEASE_TTL_SECONDS=1800
AI_STREAM_DISTRIBUTED_ADMISSION_FAIL_OPEN=false
AI_STREAM_DISTRIBUTED_WORKER_ENABLED=false
AI_STREAM_DISPATCH_MAX_ATTEMPTS=1
AI_STREAM_DISPATCH_POLL_INTERVAL_SECONDS=1.0
AI_STREAM_DISPATCH_CLAIM_STALE_SECONDS=120

# Hyperliquid AI Trading symbol ranking cache (public metaAndAssetCtxs data).
HYPERLIQUID_RANKED_SYMBOL_CACHE_SECONDS=300

# Platform-level hard risk guardrails for automated AI/Program execution.
# Production readiness requires explicit caps and TP/SL enforcement.
AI_HARD_MAX_ORDER_NOTIONAL_USD=0
AI_HARD_MAX_LEVERAGE=50
AI_HARD_MAX_SINGLE_TRADE_MARGIN_FRACTION=0.5
AI_HARD_MAX_PROJECTED_MARGIN_USAGE_PERCENT=75
AI_HARD_REQUIRE_STOP_LOSS=false
AI_HARD_REQUIRE_TAKE_PROFIT=false

# Optional external order-backend signal gateway.
# Disabled by default; when disabled, signal handoff returns 409 and does not send.
AI_TRADING_SIGNAL_GATEWAY_ENABLED=false
# V1 supports HTTP JSON handoff only. Non-http modes fail production readiness.
AI_TRADING_SIGNAL_GATEWAY_MODE=http
# AI_TRADING_SIGNAL_GATEWAY_URL=https://order-backend.example.com/api/ai-trading/signals
AI_TRADING_SIGNAL_GATEWAY_TIMEOUT_SECONDS=10
# Max signal age allowed for order-backend handoff. Set 0 to disable the age gate.
AI_TRADING_SIGNAL_MAX_HANDOFF_AGE_SECONDS=900
# Optional bearer token sent only to the order backend, never to the AI model.
# AI_TRADING_SIGNAL_GATEWAY_TOKEN=
# Production handoff readiness gate. Keep false outside an approved live
# order-backend acceptance window.
AI_TRADING_PRODUCTION_HANDOFF_APPROVED=false

# =================================================================
# Optional: Hyper Insight Integration
# =================================================================
# Login-based Hyper Insight integration uses the same Casdoor account session
# that is already synced from Hyper Alpha Arena after the user signs in.
# Only the base URL is needed here unless the deployment wants to override it.
HYPER_INSIGHT_API_BASE_URL=https://hyper.akooi.com
